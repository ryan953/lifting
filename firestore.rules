rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /exercises/{exerciseId} {
        allow read, write: if isOwner(uid);
      }

      match /templates/{templateId} {
        allow read, write: if isOwner(uid);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.status in ['active', 'completed', 'abandoned']
          && request.resource.data.startedAt is number
          && request.resource.data.exercises is list;
        allow delete: if isOwner(uid);
      }

      // Function-maintained aggregates: clients read, never write.
      match /exerciseStats/{exerciseId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /weeks/{week} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /weeklyStats/{week} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
