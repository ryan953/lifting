rules_version = '2';

// Every document lives under the owning user, and only that user may touch it.
// There is no server tier in this design, so these rules are the whole of the
// authorization model — they are written to be restrictive by default: anything
// not matched explicitly below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Guards against a client writing a document larger than anything the app
    // legitimately produces — a runaway loop shouldn't be able to run up a bill.
    function withinSizeLimit() {
      return request.resource.data.size() < 200;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && withinSizeLimit();

      // A logged session. `date` and `dayType` identify it; `blocks` holds the
      // positions. Shape is checked loosely — enough to reject junk, not so
      // tightly that the client can't evolve without a rules deploy.
      match /days/{dayKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.date is string
          && request.resource.data.dayType is string
          && request.resource.data.blocks is list
          && request.resource.data.blocks.size() <= 50;
      }

      match /favorites/{exerciseId} {
        allow read, write: if isOwner(uid);
      }

      match /supersets/{supersetId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.exerciseIds is list
          && request.resource.data.exerciseIds.size() <= 10;
      }

      // The user's own exercises.
      match /custom/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120;
      }

      // Client-side bookkeeping: seed versions, preferences.
      match /meta/{key} {
        allow read, write: if isOwner(uid);
      }

      // ----------------------------------------------------------------
      // Legacy: prototype #1, still live at ryan953-lifting-staging.web.app
      // and sharing this database. Rules are per-database and whole-file, so
      // omitting these paths would break that app the moment this file is
      // released. Delete this block once #1 is retired.
      // ----------------------------------------------------------------
      match /exercises/{exerciseId} {
        allow read, write: if isOwner(uid);
      }

      match /templates/{templateId} {
        allow read, write: if isOwner(uid);
      }

      match /sessions/{sessionId} {
        allow read, write, delete: if isOwner(uid);
      }

      // Maintained by #1's Cloud Functions; clients read only.
      match /exerciseStats/{exerciseId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /weeks/{week} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /weeklyStats/{week} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
